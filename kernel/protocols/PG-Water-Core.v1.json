{
  "id": "PG-Water-Core",
  "version": "1.0.0",
  "status": "kernel",
  "title": "Hydrological Regeneration & Flow Integrity",
  "topic": "hydrological_regeneration",
  "protocol_type": "biophysical",
  "field_13": 1,
  "biome": "watershed_multi_scale",
  "flow_stream": "elir",

  "indicators": [
    {
      "name": "Infiltration Rate",
      "metric": "infiltration_rate",
      "unit": "mm/hr",
      "frequency": "quarterly",
      "baseline": null,
      "target": "+20% over baseline"
    },
    {
      "name": "Baseflow Stability",
      "metric": "baseflow_stability_index",
      "unit": "index",
      "frequency": "seasonal",
      "baseline": null,
      "target": "reduced seasonal volatility"
    },
    {
      "name": "Turbidity",
      "metric": "turbidity_ntu",
      "unit": "NTU",
      "frequency": "monthly",
      "baseline": null,
      "target": "-15% over 12 months"
    },
    {
      "name": "Riparian Vegetation Cover",
      "metric": "riparian_cover_pct",
      "unit": "%",
      "frequency": "seasonal",
      "baseline": null,
      "target": "+10pp"
    },
    {
      "name": "Seasonal Flow Variance",
      "metric": "seasonal_flow_variance",
      "unit": "index",
      "frequency": "annual",
      "baseline": null,
      "target": "variance_stabilized"
    }
  ],

  "steps": [
    "Map watershed and flow lines",
    "Identify blockages and compaction zones",
    "Restore infiltration structures",
    "Stabilize riparian vegetation",
    "Publish seasonal hydro bulletin"
  ],

  "evidence": [
    "watershed_map.geojson",
    "flow_measurements.csv",
    "turbidity_log.csv",
    "vegetation_photos_before_after",
    "hydro_bulletin.pdf"
  ],

  "qa": [
    "10pct_measurement_crosscheck",
    "seasonal_instrument_calibration",
    "upstream_downstream_comparison",
    "satellite_cross_validation"
  ],

  "bio_regulator": {
    "monitoring_load_band": "watershed_capacity_based",
    "expansion_requires": "2_stable_seasonal_cycles",
    "pause_trigger": "turbidity_spike_gt_30pct",
    "steward_load_threshold": 0.8
  }
}
